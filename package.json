{
  "name": "jamie-signal-field",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev --test-scheduled",
    "cf:migrate:local": "wrangler d1 migrations apply jamie26-signals --local",
    "cf:migrate": "wrangler d1 migrations apply jamie26-signals --remote",
    "cf:deploy": "npm run build && npm run cf:migrate && wrangler deploy",
    "cf:sync": "node scripts/sync-signals.mjs",
    "cf:import:x": "node scripts/import-x-archive.mjs"
  },
  "dependencies": {
    "marked": "^16.2.1"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "wrangler": "^4.125.0"
  }
}
